[Unit]
Description=DevsTracker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/DevsTracker
ExecStart=/opt/DevsTracker/jre/bin/java -jar tracker-server.jar conf/DevsTracker.xml
SyslogIdentifier=DevsTracker
SuccessExitStatus=143
WatchdogSec=600
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
